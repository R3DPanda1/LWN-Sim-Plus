# Optional. Copy to .env (next to docker-compose.yml) to override defaults.
# The ChirpStack API key and URLs are normally taken from bench_config.json
# (written by seed.py), so most runs need nothing here except a ThingsBoard key.

# ChirpStack profile names — must match what seed.py creates.
ABP_PROFILE_NAME=AM319 ABP
OTAA_PROFILE_NAME=AM319 OTAA
MCF_PROFILE_NAME=MCF-LW13IO ABP
SDM_PROFILE_NAME=SDM230 ABP

# ThingsBoard, only for the provisioning cs+tb mode. Create a tenant API key in
# the ThingsBoard UI (http://localhost:9090) and paste it here.
TB_API_KEY=

# Overrides (defaults shown)
# CS_URL=http://localhost:8090
# SIM_URL=http://localhost:8002/api
# METRICS_URL=http://localhost:8003/metrics
# UPSTREAM_URL=http://localhost:8012/api
# MQTT_HOST=localhost
# MQTT_PORT=1883
